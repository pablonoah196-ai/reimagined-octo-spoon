# Discord Developer Portal > Application > OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Ex.: http://localhost:3000/auth/discord/callback
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback
# ID do servidor autorizado para o painel (opcional; vazio = escolher entre os servidores acessíveis)
