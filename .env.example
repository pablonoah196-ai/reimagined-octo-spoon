# OpenAI API key (server-side only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Segurança
SESSION_SECRET=troque-por-uma-chave-longa-e-aleatoria
PORT=3000
BASE_URL=http://localhost:3000
